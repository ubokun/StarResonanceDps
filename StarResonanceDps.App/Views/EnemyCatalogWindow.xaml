<Window x:Class="StarResonanceDps.App.Views.EnemyCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
 Title="遭遇した敵・追跡設定" Width="1060" Height="760" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{DynamicResource Font.ProjectDefault}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ExtensionViews.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="Button" BasedOn="{StaticResource Extension.Button}"/><Style TargetType="ListBox" BasedOn="{StaticResource Extension.List}"/>
 <Style TargetType="CheckBox" BasedOn="{StaticResource Extension.Switch}"/></ResourceDictionary></Window.Resources>
 <ContentControl Style="{StaticResource Panel.WindowFrame}"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:AppHeader/>
 <ContentControl Grid.Row="1" Style="{StaticResource Panel.Root}" Margin="8,1,8,8"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><WrapPanel><CheckBox x:Name="ApplyTracking" Content="有効にした敵だけタイムラインへ表示"/><Button Content="設定を保存" Click="Save_Click"/><Button Content="一覧を更新" Click="Reload_Click"/><Button x:Name="ImportButton" Content="過去の履歴から取り込む" Click="Import_Click"/></WrapPanel>
 <WrapPanel Margin="0,8"><TextBlock Text="敵名・ID・サーバーで検索" VerticalAlignment="Center"/><TextBox x:Name="Search" Style="{StaticResource Input.PathBox}" Width="300" Margin="8,0" TextChanged="Search_Changed"/><Button Content="最後の集計を開く" Click="OpenHistory_Click"/></WrapPanel>
 <TextBlock Text="種類ごとの設定を保存します。新しく見つかった種類は無効です。設定を適用すると、未知の種類と対象未確定の予告は表示対象から外れます。" TextWrapping="Wrap" Margin="0,0,0,8"/></StackPanel>
 <DataGrid Grid.Row="1" x:Name="Enemies" Style="{StaticResource Extension.Grid}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="Enemy_Selected"><DataGrid.Columns>
 <DataGridCheckBoxColumn Header="有効" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
 <DataGridTextColumn Header="敵名" Binding="{Binding Name}" IsReadOnly="True" Width="240"/>
 <DataGridTextColumn Header="種類ID" Binding="{Binding Entry.TypeId}" IsReadOnly="True" Width="100"/>
 <DataGridTextColumn Header="サーバー" Binding="{Binding Entry.Server}" IsReadOnly="True" Width="90"/>
 <DataGridTextColumn Header="初回遭遇" Binding="{Binding FirstSeen}" IsReadOnly="True" Width="140"/>
 <DataGridTextColumn Header="最終遭遇" Binding="{Binding LastSeen}" IsReadOnly="True" Width="140"/>
 </DataGrid.Columns></DataGrid>
 <ListBox Grid.Row="2" x:Name="ObservedSkills" DisplayMemberPath="Name" Margin="0,10,0,0"/>
 <TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </Grid></ContentControl><ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></ContentControl></Window>