<Window x:Class="StarResonanceDps.App.Views.UserBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ユーザービルド" Width="740" Height="650" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="#20242C" Foreground="#EEEEEE">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#303641"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#303641"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#20242C"/>
            <Setter Property="Background" Value="#EEEEEE"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="新規ビルド" Click="New_Click" Margin="0,12,0,0" Padding="8"/>
            <ListBox x:Name="BuildList" DisplayMemberPath="Name" SelectionChanged="BuildList_SelectionChanged"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存" Click="Save_Click" Padding="20,6"/>
                    <Button Content="複製" Click="Duplicate_Click" Margin="12,0,0,0" Padding="20,6"/>
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ビルド名"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/>
                    <TextBlock Text="心相"/><TextBox x:Name="MindscapeBox" AcceptsReturn="True" MinHeight="55" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="アビリティ"/><TextBox x:Name="AbilitiesBox" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="イマジン"/><TextBox x:Name="ImaginesBox" AcceptsReturn="True" MinHeight="55" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="スキルタイムライン"/>
                    <TextBlock Text="例：00:00 スキル名 ／ 00:15 イマジン名" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,4"/>
                    <TextBox x:Name="TimelineBox" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="各項目は手入力で保存できます。" Opacity="0.7" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
