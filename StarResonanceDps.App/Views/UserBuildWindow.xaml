<Window x:Class="StarResonanceDps.App.Views.UserBuildWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StarResonanceDps.App.Controls" xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
 Title="ユーザービルド" Width="1020" Height="720" MinWidth="760" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{DynamicResource Font.ProjectDefault}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ExtensionViews.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource Extension.Button}"><Setter Property="Background" Value="Transparent"/></Style>
   <Style x:Key="UserBuild.Action" TargetType="Button" BasedOn="{StaticResource Button.Text}"><Setter Property="Width" Value="Auto"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinWidth" Value="76"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
   <Style TargetType="ListBox" BasedOn="{StaticResource Extension.List}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource Input.MultilineTextBox}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource Extension.Switch}"/>
  </ResourceDictionary>
 </Window.Resources>
 <ContentControl Style="{StaticResource Panel.WindowFrame}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <controls:AppHeader/>
   <ContentControl Grid.Row="1" Margin="8,1,8,8" Style="{StaticResource Panel.Root}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <Button x:Name="SaveButton" Content="このビルドを保存" Click="Save_Click" IsEnabled="False"/>
   <Button Content="観測中のビルドを確認" Click="Preview_Click"/>
   <Button Content="保存一覧を再読込" Click="Reload_Click"/>
  </StackPanel>
  <ListBox Grid.Row="1" x:Name="Users" SelectionChanged="User_Selected" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
   <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,5">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Style="{StaticResource Text.WidgetWindow}" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
    <Button Grid.Column="1" Style="{StaticResource UserBuild.Action}" Content="アビリティ" Tag="PlayerTalent" Click="OpenUserWidget_Click"/>
    <Button Grid.Column="2" Style="{StaticResource UserBuild.Action}" Content="潜在心相" Tag="PlayerSeasonTalent" Click="OpenUserWidget_Click"/>
    <Button Grid.Column="3" Style="{StaticResource UserBuild.Action}" Content="モジュール" Tag="PlayerModule" Click="OpenUserWidget_Click"/>
   </Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0"><TextBlock DockPanel.Dock="Top" Text="保存ビルド" Margin="0,0,0,8"/><ListBox x:Name="Builds" DisplayMemberPath="Label" SelectionChanged="Build_Selected"/></DockPanel>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Grid.Row="1" Text="スキル使用の記録" Margin="0,10,0,6"/>
    <TextBox Grid.Row="2" x:Name="Timeline" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
   </ContentControl><ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"/></Grid></ContentControl>
</Window>