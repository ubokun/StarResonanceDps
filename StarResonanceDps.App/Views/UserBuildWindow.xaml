<Window x:Class="StarResonanceDps.App.Views.UserBuildWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StarResonanceDps.App.Controls" xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
 Title="ユーザー・保存ビルド・集計" Width="1020" Height="720" MinWidth="760" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{DynamicResource Font.ProjectDefault}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ExtensionViews.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource Extension.Button}"/>
   <Style TargetType="ListBox" BasedOn="{StaticResource Extension.List}"/>
   <Style TargetType="TextBox" BasedOn="{StaticResource Input.MultilineTextBox}"><Setter Property="Height" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource Extension.Switch}"/>
  </ResourceDictionary>
 </Window.Resources>
 <ContentControl Style="{StaticResource Panel.WindowFrame}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <controls:AppHeader/>
   <ContentControl Grid.Row="1" Margin="8,1,8,8" Style="{StaticResource Panel.Root}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <Button x:Name="SaveButton" Content="このビルドを保存" Click="Save_Click" IsEnabled="False"/>
   <Button Content="観測中のビルドを確認" Click="Preview_Click"/>
   <Button Content="保存一覧を再読込" Click="Reload_Click"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="ユーザー" Margin="0,0,0,8"/><ListBox x:Name="Users" DisplayMemberPath="Label" SelectionChanged="User_Selected"/></DockPanel>
   <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="保存ビルド" Margin="0,0,0,8"/><ListBox x:Name="Builds" DisplayMemberPath="Label" SelectionChanged="Build_Selected"/></DockPanel>
   <Grid Grid.Column="4">
    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Grid.Row="1" Text="このビルドに紐づく集計" Margin="0,12,0,6"/>
    <ListBox Grid.Row="2" x:Name="Encounters" DisplayMemberPath="Label" SelectionChanged="Encounter_Selected"/>
    <Button Grid.Row="3" Content="選択した集計を開く" Click="OpenEncounter_Click" Margin="0,8,0,8" HorizontalAlignment="Left"/>
    <TextBox Grid.Row="4" x:Name="Timeline" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
   </ContentControl><ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"/></Grid></ContentControl>
</Window>
