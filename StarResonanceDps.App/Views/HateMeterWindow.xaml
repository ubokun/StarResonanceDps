<Window x:Class="StarResonanceDps.App.Views.HateMeterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
 Title="ヘイトPS・技別割合" Width="1060" Height="760" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{DynamicResource Font.ProjectDefault}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ExtensionViews.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="Button" BasedOn="{StaticResource Extension.Button}"/><Style TargetType="ListBox" BasedOn="{StaticResource Extension.List}"/>
 <Style TargetType="CheckBox" BasedOn="{StaticResource Extension.Switch}"/><converters:HealthRatioToWidthConverter xmlns:converters="clr-namespace:StarResonanceDps.App.Converters" x:Key="Hate.Width"/>
 <DataTemplate x:Key="Hate.Bar"><Grid Height="46" Margin="2" ToolTip="{Binding AttributionText}"><Grid x:Name="BarHost" Margin="0,4"><Border Background="{DynamicResource Brush.ControlBackground}" CornerRadius="3"/><Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Success}" Opacity="0.25" CornerRadius="3"><Border.Width><MultiBinding Converter="{StaticResource Hate.Width}"><Binding Path="ShareRatio"/><Binding ElementName="BarHost" Path="ActualWidth"/></MultiBinding></Border.Width></Border></Grid>
 <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{Binding}" ContentTemplate="{StaticResource Extension.EventIcon}"/>
 <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="6,0"/><TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"/></Grid></Grid></DataTemplate></ResourceDictionary></Window.Resources>
 <ContentControl Style="{StaticResource Panel.WindowFrame}"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:AppHeader/>
 <ContentControl Grid.Row="1" Style="{StaticResource Panel.Root}" Margin="8,1,8,8"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><WrapPanel><Button Content="履歴を更新" Click="Reload_Click"/><ComboBox x:Name="History" Width="380" Style="{StaticResource Input.SelectBox}" DisplayMemberPath="Label" SelectionChanged="History_Selected"/><Button Content="ライブに戻る" Click="Live_Click" Margin="8,0"/></WrapPanel>
 <WrapPanel Margin="0,8"><TextBlock Text="対象の敵" VerticalAlignment="Center"/><ComboBox x:Name="Enemy" Width="330" Margin="8,0" Style="{StaticResource Input.SelectBox}" DisplayMemberPath="Name" SelectionChanged="Enemy_Selected"/><CheckBox x:Name="PartyOnly" Content="PTのみ" Click="Scope_Click"/></WrapPanel></StackPanel>
 <StackPanel Grid.Row="1"><TextBlock x:Name="Caption" FontSize="15"/><TextBlock Text="受信したヘイトの正の増加量 ÷ 集計秒数。初回受信値・減少分は加算しません。技への割り当ては推定です。" TextWrapping="Wrap" Margin="0,6,0,10"/></StackPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <DockPanel><TextBlock Text="ヘイトPSメーター（観測増加）" DockPanel.Dock="Top" FontSize="16" Margin="0,0,0,8"/><ListBox x:Name="Players" SelectionChanged="Player_Selected" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><ContentControl Content="{Binding Bar}" ContentTemplate="{StaticResource Hate.Bar}"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
 <DockPanel Grid.Column="2"><TextBlock x:Name="SkillCaption" Text="技別割合（推定）" DockPanel.Dock="Top" FontSize="16" Margin="0,0,0,8"/><ListBox x:Name="Skills" ItemTemplate="{StaticResource Hate.Bar}" HorizontalContentAlignment="Stretch"/></DockPanel></Grid>
 <TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid></ContentControl><ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></ContentControl></Window>