<Window x:Class="StarResonanceDps.App.Views.WidgetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
        xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
        xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
        xmlns:widgetSettingsViews="clr-namespace:StarResonanceDps.App.Views.WidgetSettings"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/Images/ApplicationIcon.ico"
        behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True"
        Width="760"
        Height="640"
        MinWidth="694"
        MinHeight="45"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ContentControl Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AppHeader Grid.Row="0" />

            <Grid Grid.Row="1" Margin="8,1,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsExternalScrollBarColumn" Width="16" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource Panel.Root}">
                    <StackPanel Margin="10">
                        <Button x:Name="WindowSettingsNavButton"
                                Click="WindowSettingsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasWindowSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Window}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Window_Title]}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DisplaySettingsNavButton"
                                Click="DisplaySettingsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Sliders}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Display_Title]}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayerStatusRowsNavButton"
                                Click="PlayerStatusRowsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasPlayerStatusDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.RoleSkills}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PlayerStatusSettings.RowSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffDebuffGroupEntriesNavButton"
                                Click="BuffDebuffGroupEntriesNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.RoleSkills}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffDebuffGroupSettings.Entries.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffDebuffGroupNotificationTargetsNavButton"
                                Click="BuffDebuffGroupNotificationTargetsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.NotificationTarget}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffDebuffGroupSettings.NotificationTargets.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffCardShortcutsNavButton"
                                Click="BuffCardShortcutsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffCardDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.RoleSkills}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffCardSettings.Shortcuts.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffCardNotificationTargetsNavButton"
                                Click="BuffCardNotificationTargetsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffCardDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.NotificationTarget}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffCardSettings.NotificationTargets.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OtherRoleSkillsNavButton"
                                Click="OtherRoleSkillsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding MeterSettings.ShowsOtherRoleSkillSettings, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.RoleSkills}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_OtherRoleSkills_Title]}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffListPriorityBuffsNavButton"
                                Click="BuffListPriorityBuffsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PriorityList}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffListSettings.PriorityBuffs.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EntityInfoPriorityBuffsNavButton"
                                Click="EntityInfoPriorityBuffsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PriorityList}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding EntityInfoSettings.PriorityBuffs.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffListHiddenBuffsNavButton"
                                Click="BuffListHiddenBuffsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.EyeOff}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffListSettings.HiddenBuffSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EntityInfoHiddenBuffsNavButton"
                                Click="EntityInfoHiddenBuffsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.EyeOff}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding EntityInfoSettings.HiddenBuffSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <!-- プラグインのウィジェットの節(アイコンと名前はプラグインの定義。線で描くか塗るかも定義で決まる)。 -->
                        <ItemsControl ItemsSource="{Binding PluginSettings.Sections}"
                                      Visibility="{Binding HasPluginSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="PluginSectionNavButton_Click"
                                            Style="{StaticResource Button.Sidebar}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <Path Style="{DynamicResource Icon.Stroke}"
                                                      Data="{Binding IconGeometry}"
                                                      Visibility="{Binding UsesStrokeIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Path Style="{DynamicResource Icon.Fill}"
                                                      Data="{Binding IconGeometry}"
                                                      Visibility="{Binding UsesFillIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ThemeNavButton"
                                Click="ThemeNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Theme}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Theme_Title]}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GraphColorsNavButton"
                                Click="GraphColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasMetricGraphDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding MetricGraphSettings.GraphColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayerStatusTextColorsNavButton"
                                Click="PlayerStatusTextColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasPlayerStatusDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.TextColor}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PlayerStatusSettings.TextColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EquipmentTextColorsNavButton"
                                Click="EquipmentTextColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasEquipmentDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.TextColor}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding EquipmentSettings.TextColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DamageTakenLogClassColorsNavButton"
                                Click="DamageTakenLogClassColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasDamageTakenLogDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DamageTakenLogSettings.ClassColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ElementColorsNavButton"
                                Click="ElementColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasElementColorSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ElementColorSettings.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffListColorsNavButton"
                                Click="BuffListColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffListSettings.GaugeColors.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffDebuffGroupBuffColorsNavButton"
                                Click="BuffDebuffGroupBuffColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffDebuffGroupSettings.BuffGaugeColors.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuffDebuffGroupDebuffColorsNavButton"
                                Click="BuffDebuffGroupDebuffColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BuffDebuffGroupSettings.DebuffGaugeColors.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReviveListGaugeColorsNavButton"
                                Click="ReviveListGaugeColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ReviveListSettings.GaugeColors.SectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClassColorsNavButton"
                                Click="ClassColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasMeterSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding MeterSettings.ClassColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TimelineClassColorsNavButton"
                                Click="TimelineClassColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasTimelineDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding TimelineSettings.ClassColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TimelineTextColorsNavButton"
                                Click="TimelineTextColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasTimelineDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.TextColor}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding TimelineSettings.TextColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayerInfoClassColorsNavButton"
                                Click="PlayerInfoClassColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasPlayerInfoSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PlayerInfoSettings.ClassColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReviveListClassColorsNavButton"
                                Click="ReviveListClassColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ReviveListSettings.ClassColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReviveListTextColorsNavButton"
                                Click="ReviveListTextColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.TextColor}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ReviveListSettings.TextColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EntityInfoClassColorsNavButton"
                                Click="EntityInfoClassColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.PaintBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding EntityInfoSettings.ClassColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChatTextColorsNavButton"
                                Click="ChatTextColorsNavButton_Click"
                                Style="{StaticResource Button.Sidebar}"
                                Visibility="{Binding HasChatSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.TextColor}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ChatSettings.TextColorSectionTitle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Column="2" Style="{StaticResource Panel.Root}">
                    <Grid Margin="26,22,18,18">
                        <ScrollViewer x:Name="ContentScrollViewer"
                                      Style="{StaticResource ScrollViewer.WidgetList}"
                                      VerticalScrollBarVisibility="Hidden"
                                      ScrollChanged="ContentScrollViewer_ScrollChanged"
                                      SizeChanged="ContentScrollViewer_SizeChanged">
                            <StackPanel Margin="0,0,10,6">
                                <!-- ウィンドウの枠とフォーカスの設定。全ウィジェット共通なので先頭に置く。 -->
                                <StackPanel x:Name="WindowSettingsHost"
                                            Visibility="{Binding HasWindowSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:WidgetWindowSettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </StackPanel>

                                <StackPanel x:Name="DisplaySettingsHost">
                                    <ContentControl Content="{Binding MeterSettings}"
                                                    Visibility="{Binding HasMeterDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:MeterWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding MetricGraphSettings}"
                                                    Visibility="{Binding HasMetricGraphDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:MetricGraphWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding BuffCardSettings}"
                                                    Visibility="{Binding HasBuffCardDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:BuffCardWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding TimelineSettings}"
                                                    Visibility="{Binding HasTimelineDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:TimelineWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding BuffListSettings}"
                                                    Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:BuffListWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding SkillDetailSettings}"
                                                    Visibility="{Binding HasSkillDetailDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:SkillDetailWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding EquipmentSettings}"
                                                    Visibility="{Binding HasEquipmentDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:EquipmentWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding PlayerStatusSettings}"
                                                    Visibility="{Binding HasPlayerStatusDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:PlayerStatusWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding BuffDebuffGroupSettings}"
                                                    Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:BuffDebuffGroupWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding ReviveListSettings}"
                                                    Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:ReviveListWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding DamageTakenLogSettings}"
                                                    Visibility="{Binding HasDamageTakenLogDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:DamageTakenLogWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>

                                    <ContentControl Content="{Binding EntityInfoSettings}"
                                                    Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <widgetSettingsViews:EntityInfoWidgetDisplaySettingsView />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </StackPanel>

                                <ContentControl x:Name="PlayerStatusRowsHost"
                                                Content="{Binding PlayerStatusSettings}"
                                                Visibility="{Binding HasPlayerStatusDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:PlayerStatusRowSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffDebuffGroupEntriesHost"
                                                Content="{Binding BuffDebuffGroupSettings.Entries}"
                                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffEntryListSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffDebuffGroupNotificationTargetsHost"
                                                Content="{Binding BuffDebuffGroupSettings.NotificationTargets}"
                                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffEntryListSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffCardShortcutsHost"
                                                Content="{Binding BuffCardSettings.Shortcuts}"
                                                Visibility="{Binding HasBuffCardDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffEntryListSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffCardNotificationTargetsHost"
                                                Content="{Binding BuffCardSettings.NotificationTargets}"
                                                Visibility="{Binding HasBuffCardDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffEntryListSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="OtherRoleSkillsHost"
                                                Content="{Binding MeterSettings}"
                                                Visibility="{Binding MeterSettings.ShowsOtherRoleSkillSettings, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:MeterWidgetOtherRoleSkillSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffListPriorityBuffsHost"
                                                Content="{Binding BuffListSettings.PriorityBuffs}"
                                                Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffEntryListSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <!-- エンティティ情報の優先表示リスト。中身はバフ・デバフ一覧と同じ部品。 -->
                                <ContentControl x:Name="EntityInfoPriorityBuffsHost"
                                                Content="{Binding EntityInfoSettings.PriorityBuffs}"
                                                Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffEntryListSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffListHiddenBuffsHost"
                                                Content="{Binding BuffListSettings}"
                                                Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffListHiddenBuffSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <!-- エンティティ情報の非表示リスト。中身はバフ・デバフ一覧と同じ部品。 -->
                                <ContentControl x:Name="EntityInfoHiddenBuffsHost"
                                                Content="{Binding EntityInfoSettings}"
                                                Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffListHiddenBuffSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <!-- プラグインのウィジェットの節。ウィンドウ設定とテーマのあいだ。 -->
                                <widgetSettingsViews:PluginWidgetSettingsView x:Name="PluginSettingsView"
                                                                              DataContext="{Binding PluginSettings}"
                                                                              Visibility="{Binding DataContext.HasPluginSettings, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock x:Name="ThemeSection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Theme_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Theme_WindowColor]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding WindowColors.Colors}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <RadioButton GroupName="WidgetWindowColor"
                                                                             Tag="WindowColor"
                                                                             Background="{Binding Brush}"
                                                                             Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                             Click="ColorOptionRadioButton_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}" Style="{StaticResource Button.Text}" Tag="WindowColor" Click="ColorPickerButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="134" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Theme_BackgroundImage]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0"
                                                             Width="Auto"
                                                             Height="32"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource Input.PathBox}"
                                                             Text="{Binding BackgroundImagePath, Mode=OneWay}" />

                                                    <Button Grid.Column="2"
                                                            Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Theme_SelectImage]}"
                                                            Style="{StaticResource Button.Text}"
                                                            Click="SelectBackgroundImageButton_Click" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </ContentControl>

                                <ContentControl x:Name="GraphColorsHost"
                                                Content="{Binding MetricGraphSettings}"
                                                Visibility="{Binding HasMetricGraphDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:MetricGraphColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="PlayerStatusTextColorsHost"
                                                Content="{Binding PlayerStatusSettings}"
                                                Visibility="{Binding HasPlayerStatusDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:PlayerStatusTextColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="EquipmentTextColorsHost"
                                                Content="{Binding EquipmentSettings}"
                                                Visibility="{Binding HasEquipmentDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:EquipmentTextColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="DamageTakenLogClassColorsHost"
                                                Content="{Binding DamageTakenLogSettings}"
                                                Visibility="{Binding HasDamageTakenLogDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:DamageTakenLogClassColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="ElementColorsHost"
                                                Content="{Binding ElementColorSettings}"
                                                Visibility="{Binding HasElementColorSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:MetricElementColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffListColorsHost"
                                                Content="{Binding BuffListSettings.GaugeColors}"
                                                Visibility="{Binding HasBuffListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffGaugeColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffDebuffGroupBuffColorsHost"
                                                Content="{Binding BuffDebuffGroupSettings.BuffGaugeColors}"
                                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffGaugeColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="BuffDebuffGroupDebuffColorsHost"
                                                Content="{Binding BuffDebuffGroupSettings.DebuffGaugeColors}"
                                                Visibility="{Binding HasBuffDebuffGroupDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffGaugeColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="ReviveListGaugeColorsHost"
                                                Content="{Binding ReviveListSettings.GaugeColors}"
                                                Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:BuffGaugeColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="ClassColorsHost"
                                                Content="{Binding MeterSettings}"
                                                Visibility="{Binding HasMeterSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:MeterWidgetClassColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="TimelineClassColorsHost"
                                                Content="{Binding TimelineSettings}"
                                                Visibility="{Binding HasTimelineDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:TimelineClassColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="TimelineTextColorsHost"
                                                Content="{Binding TimelineSettings}"
                                                Visibility="{Binding HasTimelineDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:TimelineTextColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="PlayerInfoClassColorsHost"
                                                Content="{Binding PlayerInfoSettings}"
                                                Visibility="{Binding HasPlayerInfoSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:PlayerInfoClassColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="ReviveListClassColorsHost"
                                                Content="{Binding ReviveListSettings}"
                                                Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:ReviveListClassColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="ReviveListTextColorsHost"
                                                Content="{Binding ReviveListSettings}"
                                                Visibility="{Binding HasReviveListDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:ReviveListTextColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="EntityInfoClassColorsHost"
                                                Content="{Binding EntityInfoSettings}"
                                                Visibility="{Binding HasEntityInfoDisplaySettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:EntityInfoClassColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <ContentControl x:Name="ChatTextColorsHost"
                                                Content="{Binding ChatSettings}"
                                                Visibility="{Binding HasChatSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <widgetSettingsViews:ChatTextColorSettingsView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>

                <ScrollBar x:Name="SettingsExternalScrollBar"
                           Grid.Column="3"
                           Margin="5,0,5,0"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetList}"
                           ValueChanged="SettingsExternalScrollBar_ValueChanged" />
            </Grid>

            <Grid Grid.Row="2" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Reset]}"
                            Click="ResetButton_Click"
                            Style="{StaticResource Button.Text}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Save]}"
                            Margin="12,0,0,0"
                            Click="SaveButton_Click"
                            Style="{StaticResource Button.Text}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
