<Window x:Class="StarResonanceDps.App.Views.CombatTimelineWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StarResonanceDps.App.Controls" xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
 Title="拡張タイムライン・クエスト同期" Width="1180" Height="850" MinWidth="900" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{DynamicResource Font.ProjectDefault}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ExtensionViews.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource Extension.Button}"/>
   <Style TargetType="ListBox" BasedOn="{StaticResource Extension.List}"/>
   <Style TargetType="TextBox" BasedOn="{StaticResource Input.MultilineTextBox}"><Setter Property="Height" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource Extension.Switch}"/>
  </ResourceDictionary>
 </Window.Resources>
 <ContentControl Style="{StaticResource Panel.WindowFrame}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <controls:AppHeader/>
   <ContentControl Grid.Row="1" Margin="8,1,8,8" Style="{StaticResource Panel.Root}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <ContentControl x:Name="MeasurementSettings" Visibility="Collapsed" Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,10"><StackPanel Margin="12">
   <WrapPanel>
    <CheckBox x:Name="QuestClock" Content="クエスト時間と同期"/>
    <CheckBox x:Name="QuestReset" Content="クエスト開始でリセット"/>
    <TextBlock Text="無操作リセット(秒、0=無効)" VerticalAlignment="Center"/>
    <TextBox x:Name="IdleSeconds" Style="{StaticResource Input.PathBox}" Width="60" Margin="6,0,12,0"/>
    <TextBlock Text="定期リセット(秒、0=無効)" VerticalAlignment="Center"/>
    <TextBox x:Name="IntervalSeconds" Style="{StaticResource Input.PathBox}" Width="60" Margin="6,0,12,0"/>
    <Button Content="設定を保存" Click="SaveSettings_Click"/>
    <Button Content="今リセット" Click="Reset_Click"/>
   </WrapPanel>
   <TextBlock Text="同期は次のクエスト開始から適用。同期中は1クエストを1集計とし、時間リセットと自動フェーズ分割を停止します。同期なしの場合は既存の「進行で自動リセット」設定にも従います。" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,6"/>
   </StackPanel></ContentControl>
   <WrapPanel>
    <Button Content="PT DPS推移" Click="PartyDps_Click"/>
    <Button Content="遭遇した敵" Click="EnemyCatalog_Click"/>
    <Button Content="技フィルター" Click="ToggleActionFilter_Click"/>
    <Button Content="計測設定" Click="ToggleMeasurementSettings_Click"/>
    <Button Content="履歴を更新" Click="RefreshHistory_Click"/>
    <ComboBox x:Name="History" Style="{StaticResource Input.SelectBox}" Width="430" DisplayMemberPath="Label" SelectionChanged="History_Selected"/>
    <Button Content="ライブに戻る" Click="Live_Click" Margin="12,0,0,0"/>
   </WrapPanel>
   <ContentControl x:Name="ActionFilterPanel" Visibility="Collapsed" Style="{StaticResource Panel.SettingSection}" Margin="0,8,0,0">
    <StackPanel Margin="10">
     <WrapPanel><CheckBox x:Name="FilterActions" Content="技フィルターを有効にする" Click="ActionFilterChanged"/>
      <TextBlock Text="技名で検索" VerticalAlignment="Center"/><TextBox x:Name="ActionSearch" Width="200" Margin="8,0" TextChanged="ActionSearchChanged"/>
      <Button Content="すべて選択" Click="SelectAllActions_Click"/><Button Content="選択を解除" Click="ClearActions_Click"/>
      <Button Content="既定に戻す" Click="DefaultActions_Click"/><Button Content="フィルターを保存" Click="SaveSettings_Click"/>
     </WrapPanel>
     <TextBlock Text="平均10秒に1回以上の技は既定で非表示。手動選択を優先します。検索は候補だけを絞り込み、DPSグラフと保存データには影響しません。" Margin="0,4" TextWrapping="Wrap"/>
     <ListBox x:Name="ActionChoices" Height="110" SelectionMode="Multiple" SelectionChanged="ActionChoices_Selected">
      <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" Style="{StaticResource Extension.Switch}" Margin="0" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </ContentControl>
   <WrapPanel Margin="0,8,0,0">
    <CheckBox x:Name="PartyOnly" Content="PTのみ"/>
    <CheckBox x:Name="Skills" Content="スキル"/><CheckBox x:Name="Imagines" Content="イマジン"/>
    <CheckBox x:Name="Factors" Content="因子効果"/><CheckBox x:Name="Enemies" Content="敵行動"/>
    <TextBlock Text="表示幅(秒)" VerticalAlignment="Center"/><TextBox x:Name="WindowSeconds" Style="{StaticResource Input.PathBox}" Width="60" Margin="6,0,12,0"/>
    <CheckBox x:Name="Follow" Content="最新を追尾" IsChecked="True"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,8,0,10">
   <TextBlock x:Name="Caption" FontSize="15" TextWrapping="Wrap"/>
   <Slider x:Name="TimeOffset" Style="{StaticResource Input.ValueSlider}" Minimum="0" Maximum="0" ValueChanged="TimeOffset_Changed"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="追跡対象（複数選択、未選択=全対象）" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <Button DockPanel.Dock="Bottom" Content="全対象に戻す" Click="AllActors_Click" Margin="0,8,0,0"/>
    <ListBox x:Name="Actors" DisplayMemberPath="Name" SelectionMode="Multiple" SelectionChanged="Actors_Selected"/>
   </DockPanel>
   <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.InputBackground}">
    <Canvas x:Name="Plot" Width="1120" Height="420"/>
   </ScrollViewer>
  </Grid>
  <DataGrid Grid.Row="3" x:Name="EventList" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="False"
   Style="{StaticResource Extension.Grid}" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="" Width="38" CellTemplate="{StaticResource Extension.EventIcon}"/>
    <DataGridTextColumn Header="時刻" Binding="{Binding Time}" Width="110"/>
    <DataGridTextColumn Header="トラック" Binding="{Binding Track}" Width="90"/>
    <DataGridTextColumn Header="対象" Binding="{Binding Actor}" Width="140"/>
    <DataGridTextColumn Header="イベント" Binding="{Binding Action}" Width="*" MinWidth="360"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" Text="因子は識別できたバフ付与・効果通知を記録。旧履歴には因子イベント・PT所属情報がない場合があります。"/>
 </Grid>
   </ContentControl><ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"/></Grid></ContentControl>
</Window>
