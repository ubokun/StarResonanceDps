<Window x:Class="StarResonanceDps.App.Views.CombatTimelineWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="拡張タイムライン・クエスト同期" Width="1180" Height="850" MinWidth="900" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#20242C" Foreground="#EEEEEE">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#20242C"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#303641"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,14,4"/><Setter Property="Foreground" Value="#EEEEEE"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#303641"/><Setter Property="Foreground" Value="#EEEEEE"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <WrapPanel>
    <CheckBox x:Name="QuestClock" Content="クエスト時間と同期"/>
    <CheckBox x:Name="QuestReset" Content="クエスト開始でリセット"/>
    <CheckBox x:Name="AutoLink" Content="保存済みユーザーのビルドを自動紐づけ"/>
    <TextBlock Text="無操作リセット(秒、0=無効)" VerticalAlignment="Center"/>
    <TextBox x:Name="IdleSeconds" Width="60" Margin="6,0,12,0"/>
    <TextBlock Text="定期リセット(秒、0=無効)" VerticalAlignment="Center"/>
    <TextBox x:Name="IntervalSeconds" Width="60" Margin="6,0,12,0"/>
    <Button Content="設定を保存" Click="SaveSettings_Click"/>
    <Button Content="今リセット" Click="Reset_Click"/>
   </WrapPanel>
   <TextBlock Text="同期は次のクエスト開始から適用。同期中は1クエストを1集計とし、時間リセットと自動フェーズ分割を停止します。同期なしの場合は既存の「進行で自動リセット」設定にも従います。" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,6"/>
   <WrapPanel>
    <Button Content="履歴を更新" Click="RefreshHistory_Click"/>
    <ComboBox x:Name="History" Width="430" DisplayMemberPath="Label" SelectionChanged="History_Selected"/>
    <Button Content="ライブに戻る" Click="Live_Click" Margin="12,0,0,0"/>
   </WrapPanel>
   <WrapPanel Margin="0,8,0,0">
    <CheckBox x:Name="PartyOnly" Content="PTのみ"/>
    <CheckBox x:Name="Skills" Content="スキル"/><CheckBox x:Name="Imagines" Content="イマジン"/>
    <CheckBox x:Name="Factors" Content="因子効果"/><CheckBox x:Name="Enemies" Content="敵行動"/>
    <TextBlock Text="表示幅(秒)" VerticalAlignment="Center"/><TextBox x:Name="WindowSeconds" Width="60" Margin="6,0,12,0"/>
    <CheckBox x:Name="Follow" Content="最新を追尾" IsChecked="True"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,8,0,10">
   <TextBlock x:Name="Caption" FontSize="15" TextWrapping="Wrap"/>
   <Slider x:Name="TimeOffset" Minimum="0" Maximum="0" ValueChanged="TimeOffset_Changed"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="追跡対象（複数選択、未選択=全対象）" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <Button DockPanel.Dock="Bottom" Content="全対象に戻す" Click="AllActors_Click" Margin="0,8,0,0"/>
    <ListBox x:Name="Actors" DisplayMemberPath="Name" SelectionMode="Multiple" SelectionChanged="Actors_Selected"/>
   </DockPanel>
   <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#181D25">
    <Canvas x:Name="Plot" Width="1120" Height="420"/>
   </ScrollViewer>
  </Grid>
  <DataGrid Grid.Row="3" x:Name="EventList" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="False"
   Background="#303641" Foreground="#20242C" EnableRowVirtualization="True">
   <DataGrid.Columns><DataGridTextColumn Header="時刻" Binding="{Binding Time}" Width="110"/>
    <DataGridTextColumn Header="トラック" Binding="{Binding Track}" Width="90"/>
    <DataGridTextColumn Header="対象" Binding="{Binding Actor}" Width="140"/>
    <DataGridTextColumn Header="イベント" Binding="{Binding Action}" Width="*" MinWidth="360"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" Text="因子は識別できたバフ付与・効果通知を記録。旧履歴には因子イベント・PT所属情報がない場合があります。"/>
 </Grid>
</Window>
