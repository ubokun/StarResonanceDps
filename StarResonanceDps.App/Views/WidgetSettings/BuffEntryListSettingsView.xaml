<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.BuffEntryListSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        バフ・デバフの行ごとのオン/オフ(バフ・デバフグループの「バフ・デバフ」とバフ・デバフカードの「ショートカット」、両方の「通知対象」、
        バフ・デバフ一覧とエンティティ情報の「優先表示リスト」、DataContext は BuffEntryListSettingsViewModel)。
        行の作りは「ステータス」の一覧と同じ(左にアイコンと名前、右にスイッチ)で、アイコンの枠は非表示リストの行と同じ。
        行はスイッチ以外の所を掴んで並べ替えられる(RowReorderBehavior。写して薄くするのは行の中身 RowContent)。「通知対象」は並べ替えない。
        見出しの下の注意書きは2つ。1つ目は行の足し方(作りは非表示リストの説明と同じ)、2つ目は並べ替えの文言で作りは「ステータス」の一覧と同じ(どちらも持ち主ごとに違う)。
        並べ替えない一覧は2つ目を出さない。注意書きと一覧のあいだは、注意書きの数に関係なく 10(行の下の 4 と囲みの下の 6)。
    -->
    <StackPanel>
        <TextBlock Text="{Binding SectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding Description}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />
            <TextBlock Text="{Binding ReorderNote}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       Visibility="{Binding AllowsReorder, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Entries}"
                          behaviors:RowReorderBehavior.ContentElementName="RowContent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.SettingField}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- 並べ替えで写して薄くするのはこの Grid(アイコン・名前・スイッチ)だけ。区切り線は Border が描くので写さず薄くしない。 -->
                            <Grid x:Name="RowContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 枠は一覧の行と同じ 30×30。モジュール効果の絵だけ枠の中で小さく出し、因子の絵は大きさはそのままで左へずらす(どちらも一覧の行と同じ値)。 -->
                                <Grid Grid.Column="0"
                                      Width="30"
                                      Height="30"
                                      Margin="-1,0,0,0"
                                      VerticalAlignment="Center">
                                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModuleEffectIcon}" Value="True">
                                                        <Setter Property="Width" Value="26" />
                                                        <Setter Property="Height" Value="26" />
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform X="-1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFactorIcon}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform X="-1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- 絵のパスはあるのにファイルが無いバフははてな(一覧の行と同じ作り)。大きさは絵の枠いっぱい。 -->
                                    <Rectangle Fill="White"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                        </Rectangle.OpacityMask>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowsUnknownIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!-- 絵が Icons.xaml の絵(装備効果)なら、白く塗った面をその絵で型抜きする(一覧の行と同じ作り、左へ 1 ずらすのも同じ)。 -->
                                    <Rectangle Fill="White"
                                               OpacityMask="{Binding IconMask}"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform X="-1" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconMask}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,12,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ToggleButton Style="{StaticResource Input.Switch}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               MinWidth="28"
                                               Text="{Binding StateText}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </StackPanel>
</UserControl>
