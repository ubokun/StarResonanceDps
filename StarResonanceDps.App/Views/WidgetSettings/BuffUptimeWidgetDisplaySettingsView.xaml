<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.BuffUptimeWidgetDisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:widgetSettings="clr-namespace:StarResonanceDps.App.ViewModels.WidgetSettings"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        バフ稼働率の表示設定。スイッチ2つは被ダメログの「最新の被ダメのみ表示」と同じ作り、
        「横軸の長さ」は推移グラフの表示設定と同じ作り。
    -->
    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Display_Title]}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}"
                        Margin="0,0,0,12">
            <StackPanel>
                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_BuffUptime_ShowsPermanentBuffs]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding ShowsPermanentBuffs, Mode=TwoWay}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="28"
                                       Text="{Binding ShowsPermanentBuffsStateText}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_BuffUptime_ShowsCuisinePotion]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding ShowsCuisinePotion, Mode=TwoWay}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="28"
                                       Text="{Binding ShowsCuisinePotionStateText}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingFieldLast}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_BuffUptime_PixelsPerSecond]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="{x:Static widgetSettings:BuffUptimeWidgetSettingsViewModel.PixelsPerSecondSliderMinimum}"
                                    Maximum="{x:Static widgetSettings:BuffUptimeWidgetSettingsViewModel.PixelsPerSecondSliderMaximum}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding PixelsPerSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- 欄の幅はいちばん長い値の文字(見えない)で決め、値が変わっても溝の長さを変えない。 -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Visibility="Hidden"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding PixelsPerSecondMaxText}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding PixelsPerSecondText}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
