<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.MetricGraphColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        グラフカラー(推移グラフの線の色とバフ稼働率のバーの色。中身は GraphColorSettingsViewModel)。
        行の作りはメーターのクラスカラー(MeterWidgetClassColorSettingsView)と同じで、不透明度は持たない。
        クラスアイコンの欄に、推移グラフは折れ線、バフ稼働率はバーの見本を出す(メーターのクラスアイコンと同じく、選んでいる色で描いて影を付ける)。
    -->
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding SectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.SettingField}">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          Width="27"
                                          Height="27"
                                          VerticalAlignment="Center">
                                        <!-- 推移グラフの見本。2回折れる線(/＼/)で、上下の端をそろえて欄の中央に置く。グラフの線と同じく端と角を丸める。 -->
                                        <Polyline Points="3,19 10,8 17,19 24,8"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stroke="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}">
                                            <Polyline.Style>
                                                <Style TargetType="Polyline">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.UsesBarSwatch, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Polyline.Style>
                                            <Polyline.Effect>
                                                <DropShadowEffect
                                                    Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                    Opacity="0.5"
                                                    ShadowDepth="0"
                                                    BlurRadius="5" />
                                            </Polyline.Effect>
                                        </Polyline>

                                        <!-- バフ稼働率の見本。太さはウィジェットのバーと同じ 10、長さは折れ線の横の範囲(3〜24)と同じ 21 で、欄の中央に置く。角は丸めない。 -->
                                        <Rectangle Width="21"
                                                   Height="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.UsesBarSwatch, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                    Opacity="0.5"
                                                    ShadowDepth="0"
                                                    BlurRadius="5" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                 Background="{Binding Brush}"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Click="ColorOptionRadioButton_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                                Style="{StaticResource Button.Text}"
                                                Tag="{Binding Key}"
                                                Click="ColorPickerButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
