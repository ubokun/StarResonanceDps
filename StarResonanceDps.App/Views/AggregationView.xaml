<UserControl x:Class="StarResonanceDps.App.Views.AggregationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             Foreground="{DynamicResource Brush.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!--
            ボタン2種(上の操作ボタン・履歴の行)は Styles/Buttons.xaml の
            Button.AggregationAction / Button.AggregationRow。
            **枠は Surface.RoundedOutline が持つ**ので、ここには置かない。

            残すのは、共有のピル(Styles/Panels.xaml の Panel.StatusPill)をこのビューの条件で出す派生だけ。
        -->

        <Style x:Key="Aggregation.ViewingPill" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.StatusPill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 押した回を DB から読んでいる間。読み終えて表示中になれば「表示中」に替わる。 -->
        <Style x:Key="Aggregation.LoadingPill" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.StatusPill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            見出しと、エンカウンターへの操作2つ。
            **見出しは状態を出すだけで押せない。** ライブへ戻すのは選択中の行をもう一度押す操作で、
            ここに入口を二重に置かない。
        -->
        <Grid Grid.Row="0" Margin="8,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="{Binding StatusText}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.AggregationAction}"
                        Command="{Binding ToggleBenchmarkCommand}"
                        Content="{Binding BenchmarkText}" />
                <Button Style="{StaticResource Button.AggregationAction}"
                        Margin="8,0,0,0"
                        Command="{Binding ResetEncounterCommand}"
                        Content="{Binding ResetText}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="8,0,0,12">
            <WrapPanel>
                <StackPanel Margin="0,0,12,6"><TextBlock Text="ユーザー（名前・ID）"/><TextBox Style="{StaticResource Input.SearchBox}" Width="190" Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,12,6"><TextBlock Text="クエスト（名称）"/><TextBox Style="{StaticResource Input.SearchBox}" Width="190" Text="{Binding QuestFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <Button Content="解除" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" Style="{StaticResource Button.AggregationAction}"/>
            </WrapPanel>
            <TextBlock Text="{Binding FilterStatus}" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <!-- 行1つ目が来る位置に合わせて置く。 -->
        <TextBlock Grid.Row="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Text="{Binding EmptyText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer x:Name="HistoryScrollViewer"
                      Grid.Row="2"
                      Style="{StaticResource ScrollViewer.WidgetList}"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 選択中の行をもう一度押すと解除。判定はビューモデル側。 -->
                        <Button Style="{StaticResource Button.AggregationRow}"
                                Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="154" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    FontSize="16"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding TimeText}" />

                                <TextBlock Grid.Column="1"
                                    Style="{StaticResource Text.WidgetName}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding SceneText}" />

                                <Border Grid.Column="2" Style="{StaticResource Aggregation.ViewingPill}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Aggregation_Viewing]}" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Aggregation.LoadingPill}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Aggregation_Loading]}" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
