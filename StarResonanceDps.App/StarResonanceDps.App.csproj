  <!-- 更新で置き換えるファイルの一覧(AppUpdateApplier.FileListName)。公開の出力が全部そろってから書く。 -->
  <Target Name="WriteUpdateFileList" AfterTargets="Publish" DependsOnTargets="CopyBundledPluginAssembliesToPublish;CopyHotkeyHostToPublish">
    <ItemGroup>
      <_UpdateListedFile Include="$(PublishDir)**\*" Exclude="$(PublishDir)update-files.txt" />
    </ItemGroup>

    <WriteLinesToFile File="$(PublishDir)update-files.txt"
                      Lines="@(_UpdateListedFile->'%(RecursiveDir)%(Filename)%(Extension)')"
                      Overwrite="true" />
  </Target>

