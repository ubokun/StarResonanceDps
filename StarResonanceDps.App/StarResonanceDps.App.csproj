<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK の版は WinRT の API(Windows の音声・Windows の通知)をコードから呼ぶためだけに付ける。
         対応する Windows の範囲は SupportedOSPlatformVersion で版を付けないときと同じ値に保ち、WinRT は実行時に版を確かめて呼ぶ。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StarResonanceDps</AssemblyName>
    <Version>4.0.0</Version>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Images\ApplicationIcon.ico</ApplicationIcon>
    <!-- 参照先の説明の XML(SDK の StarResonanceDps.PluginSdk.xml)は、プラグインを作る人向けのパッケージに入れるもので、アプリの配布物には入れない。 -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

