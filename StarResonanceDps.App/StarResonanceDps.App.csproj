  <Target Name="RemoveObsoleteLocalizationSatelliteOutputs" AfterTargets="Build">
    <ItemGroup>
      <_LegacyLocalizationSatelliteAssemblies Include="$(OutDir)ja-JP\$(AssemblyName).resources.dll;$(OutDir)ko-KR\$(AssemblyName).resources.dll;$(OutDir)zh-CN\$(AssemblyName).resources.dll" />
      <_OtherJapaneseCultureFiles Include="$(OutDir)ja-JP\*.*" Exclude="$(OutDir)ja-JP\$(AssemblyName).resources.dll" />
      <_OtherKoreanCultureFiles Include="$(OutDir)ko-KR\*.*" Exclude="$(OutDir)ko-KR\$(AssemblyName).resources.dll" />
      <_OtherChineseCultureFiles Include="$(OutDir)zh-CN\*.*" Exclude="$(OutDir)zh-CN\$(AssemblyName).resources.dll" />
    </ItemGroup>

    <Delete Files="@(_LegacyLocalizationSatelliteAssemblies)" />
    <RemoveDir Directories="$(OutDir)ja-JP" Condition="'@(_OtherJapaneseCultureFiles)' == ''" />
    <RemoveDir Directories="$(OutDir)ko-KR" Condition="'@(_OtherKoreanCultureFiles)' == ''" />
    <RemoveDir Directories="$(OutDir)zh-CN" Condition="'@(_OtherChineseCultureFiles)' == ''" />
  </Target>

  <!--
    同梱プラグインと補助は版を付けない net10.0-windows のまま(WinRT を引き込まない)。App の TargetFramework から組まない。
    -r を付けた公開では、Exe の補助だけ RID のフォルダに出て、ライブラリのプラグインは RID なしのフォルダに出る。
  -->
  <PropertyGroup>
    <BundledPluginOutputSubdirectory>net10.0-windows</BundledPluginOutputSubdirectory>
    <HotkeyHostOutputSubdirectory>net10.0-windows</HotkeyHostOutputSubdirectory>
    <HotkeyHostOutputSubdirectory Condition="'$(RuntimeIdentifier)' != ''">net10.0-windows\$(RuntimeIdentifier)</HotkeyHostOutputSubdirectory>
    <ModulePluginAssembly>$(MSBuildProjectDirectory)\..\StarResonanceDps.Plugins.ModuleTool\bin\$(Configuration)\$(BundledPluginOutputSubdirectory)\ModuleTool.dll</ModulePluginAssembly>
  </PropertyGroup>

  <!-- プラグインは Plugins\<アセンブリ名>\ に1つずつ置く。フォルダには設定ファイルも入るので、フォルダごと消さない。直下の DLL は前の置き方の残り。 -->
  <Target Name="CopyBundledPluginAssemblies" AfterTargets="Build">
    <Delete Files="$(OutDir)Plugins\ModuleTool.dll;$(OutDir)Plugins\plugin.json;$(OutDir)Plugins\ModuleTool.deps.json;$(OutDir)Plugins\ModuleTool.runtimeconfig.json" />

    <MakeDir Directories="$(OutDir)Plugins\ModuleTool" />
    <Copy SourceFiles="$(ModulePluginAssembly)" DestinationFiles="$(OutDir)Plugins\ModuleTool\ModuleTool.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginAssembliesToPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Plugins\ModuleTool.dll;$(PublishDir)Plugins\plugin.json;$(PublishDir)Plugins\ModuleTool.deps.json;$(PublishDir)Plugins\ModuleTool.runtimeconfig.json" />

    <MakeDir Directories="$(PublishDir)Plugins\ModuleTool" />
    <Copy SourceFiles="$(ModulePluginAssembly)" DestinationFiles="$(PublishDir)Plugins\ModuleTool\ModuleTool.dll" SkipUnchangedFiles="true" />
  </Target>

  <!-- ホットキーの補助(管理者権限で動く別の実行ファイル)は実行フォルダの直下に置く。 -->
  <PropertyGroup>
    <HotkeyHostOutputDirectory>$(MSBuildProjectDirectory)\..\StarResonanceDps.HotkeyHost\bin\$(Configuration)\$(HotkeyHostOutputSubdirectory)\</HotkeyHostOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <HotkeyHostFiles Include="$(HotkeyHostOutputDirectory)StarResonanceDps.HotkeyHost.exe" />
    <HotkeyHostFiles Include="$(HotkeyHostOutputDirectory)StarResonanceDps.HotkeyHost.dll" />
    <HotkeyHostFiles Include="$(HotkeyHostOutputDirectory)StarResonanceDps.HotkeyHost.runtimeconfig.json" />
    <HotkeyHostFiles Include="$(HotkeyHostOutputDirectory)StarResonanceDps.HotkeyHost.deps.json" />
  </ItemGroup>

  <Target Name="CopyHotkeyHost" AfterTargets="Build">
    <Copy SourceFiles="@(HotkeyHostFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyHotkeyHostToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(HotkeyHostFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\StarResonanceDps.Core\Data\**\*.json">
