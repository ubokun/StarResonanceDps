<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:converters="clr-namespace:StarResonanceDps.App.Converters" xmlns:runtime="clr-namespace:StarResonanceDps.Core.CombatRuntime;assembly=StarResonanceDps.Core">
 <converters:SkillIconImageConverter x:Key="Extension.IconImageConverter"/>
 <DataTemplate x:Key="Extension.EventIcon">
  <Grid Width="26" Height="26" ToolTip="{Binding Action}">
   <Image Stretch="Uniform">
    <Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{StaticResource Icon.RoleSkillFrame}"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding Frame}" Value="{x:Static runtime:SkillIconFrame.Imagine}"><Setter Property="Source" Value="{StaticResource Icon.ImagineSkillFrame}"/></DataTrigger>
      <DataTrigger Binding="{Binding Frame}" Value="{x:Static runtime:SkillIconFrame.Ultimate}"><Setter Property="Source" Value="{StaticResource Icon.UltimateSkillFrame}"/></DataTrigger>
      <DataTrigger Binding="{Binding Track}" Value="イマジン"><Setter Property="Source" Value="{StaticResource Icon.ImagineSkillFrame}"/></DataTrigger>
      <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding Track}" Value="因子効果"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers>
    </Style></Image.Style>
   </Image>
   <TextBlock Text="{Binding FallbackGlyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
     <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <Image Width="22" Height="22" Stretch="Uniform" Effect="{StaticResource Effect.WidgetWindowTextShadow}" Source="{Binding IconPath, Converter={StaticResource Extension.IconImageConverter}}"/>
  </Grid>
 </DataTemplate>
 <Style x:Key="Extension.Button" TargetType="Button" BasedOn="{StaticResource Button.Text}">
  <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,8,0"/>
 </Style>
 <Style x:Key="Extension.ListItem" TargetType="ListBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,9"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource Radius.Button}" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ControlActiveBackground}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Extension.List" TargetType="ListBox">
  <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="4"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource Extension.ListItem}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Button}" Padding="{TemplateBinding Padding}">
    <ScrollViewer Focusable="False" Style="{StaticResource ScrollViewer.WidgetList}"><ItemsPresenter/></ScrollViewer>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Extension.Switch" TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Margin" Value="0,5,16,5"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <StackPanel Orientation="Horizontal" Background="Transparent">
    <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ToggleButton Style="{StaticResource Input.Switch}" IsChecked="{TemplateBinding IsChecked}" IsHitTestVisible="False" Focusable="False"/>
   </StackPanel>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Extension.Grid" TargetType="DataGrid">
  <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  <Setter Property="RowBackground" Value="{DynamicResource Brush.InputBackground}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.PanelBackground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.BorderSoft}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="30"/>
  <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
   <Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style></Setter.Value></Setter>
  <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.ControlActiveBackground}"/></Trigger></Style.Triggers>
  </Style></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
