<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ThemeManager updates the derived application theme brushes directly. -->
    <SolidColorBrush x:Key="Brush.WindowSurface" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#121D2B" />
    <SolidColorBrush x:Key="Brush.Border" Color="#323B47" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="#212B38" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#434B56" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#232D3A" />
    <SolidColorBrush x:Key="Brush.ControlActiveBackground" Color="#303945" />
    <SolidColorBrush x:Key="Brush.WidgetCardImageButtonBackground" Color="#80232D3A" />
    <SolidColorBrush x:Key="Brush.WidgetCardImageButtonActiveBackground" Color="#80303945" />
    <SolidColorBrush x:Key="Brush.WidgetCardImageButtonBorder" Color="#80323B47" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#101B28" />
    <SolidColorBrush x:Key="Brush.InputHoverBackground" Color="#1A2431" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#EDEEEF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A2A6AC" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#686F77" />
    <SolidColorBrush x:Key="Brush.Success" Color="#43D978" />
    <SolidColorBrush x:Key="Brush.Stopped" Color="#7C8796" />
    <!-- ウィジェットの状態の印の黄と赤(緑は Brush.Success、窓が無いときは Brush.Stopped)。テーマでは変えない。 -->
    <SolidColorBrush x:Key="Brush.DataStatusPartial" Color="#FFCC4D" />
    <SolidColorBrush x:Key="Brush.DataStatusUnavailable" Color="#FF5A5A" />
    <!-- 戦闘状態の印の色(Icons.xaml の Icon.CombatStateMask)。テーマでは変えない。 -->
    <SolidColorBrush x:Key="Brush.CombatState" Color="#D9866C" />
</ResourceDictionary>
